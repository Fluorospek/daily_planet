# Embedding Provider Configuration
# Choose between "local" (Sentence Transformers) or "huggingface" (Hugging Face Inference API)
EMBEDDING_PROVIDER=local

# Embedding Model Name
# For local: e.g. all-MiniLM-L6-v2, sentence-transformers/all-mpnet-base-v2, BAAI/bge-small-en-v1.5
# For huggingface: e.g. sentence-transformers/all-MiniLM-L6-v2, sentence-transformers/all-mpnet-base-v2, BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hugging Face API Token (Required for EMBEDDING_PROVIDER=huggingface)
HF_TOKEN=your_huggingface_api_token_here

# Vector Database Configuration
QDRANT_URL=http://localhost:6333
